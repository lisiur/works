---
/**
 * 站点首页页脚：应用链接清单（由应用清单数据驱动）+ 版权行，与基线一致（无 onclick）。
 */
import { apps, localeInfo } from '../data/apps';
import { type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  copyright: string;
}
const { locale, copyright } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-links">
    {apps.map((app) => <a href={`/${app.id}/`}>{localeInfo(app, locale).name}</a>)}
  </div>
  <p>{copyright}</p>
</footer>
