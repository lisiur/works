---
/**
 * 站点首页导航：logo（SVG 方块）+ 语言互切（站点首页无 nav-links，与基线一致）。
 * 语言胶囊按登记生成：其余每种语言一颗（D3），标签为目标语言自称。
 */
import LangPill from './LangPill.astro';
import { otherLocales } from '../i18n';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const others = otherLocales(locale);
---

<header class="site-nav">
  <a class="nav-logo" href={`/${locale}/`}>
    <div class="nav-logo-icon">
      <svg viewBox="0 0 24 24"><rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="8" rx="2"/><rect x="3" y="13" width="8" height="8" rx="2"/><rect x="13" y="13" width="8" height="8" rx="2"/></svg>
    </div>
    <span>Hapaul Apps</span>
  </a>
  <div class="nav-right">
    {others.map((entry) => <LangPill href={`/${entry.code}/`} locale={entry.code} label={entry.nativeLabel} />)}
  </div>
</header>
