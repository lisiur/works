---
/**
 * 首页应用卡片：图标 / 入口来自应用清单，名称 / 简介来自应用文案（AC11）。
 */
import { appCopyOf, type AppEntry } from '../i18n';

interface Props {
  app: AppEntry;
  locale: string;
}
const { app, locale } = Astro.props;
const copy = appCopyOf(app.id)[locale] as { name: string; tagline: string };
---

<a class="app-card" href={`/${app.id}/`}>
  <img class="app-card-icon" src={app.icon} alt={app.jumpTitle}>
  <h3 class="app-card-name">{copy.name}</h3>
  <p class="app-card-desc">{copy.tagline}</p>
</a>
