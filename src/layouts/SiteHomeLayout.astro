---
/**
 * 站点首页骨架：文案取自站点层文案数据，卡片与页脚链接由应用清单驱动（加应用/加语言不改本文件）。
 * hreflang 列表由语言登记生成（登记序）。
 */
import HeadMeta from '../components/HeadMeta.astro';
import SiteNav from '../components/SiteNav.astro';
import AppCard from '../components/AppCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { apps } from '../data/apps';
import { abs, localeEntries, localeEntryOf, siteCopyOf, type AlternateLink } from '../i18n';
import '../styles/site.css';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const entry = localeEntryOf(locale);
const copy = siteCopyOf(locale);
const canonical = abs(`/${locale}/`);
const alternates: AlternateLink[] = localeEntries.map((alt) => ({
  hreflang: alt.hreflang,
  href: abs(`/${alt.code}/`),
}));
---

<!DOCTYPE html>
<html lang={entry.htmlLang}>
<head>
  <HeadMeta title={copy.home.title} canonical={canonical} alternates={alternates} />
</head>
<body>
  <SiteNav locale={locale} />

  <main>
    <!-- Hero -->
    <section class="hero">
      <h1>Hapaul Apps</h1>
      <p class="tagline">{copy.home.heroTagline}</p>
    </section>

    <!-- Apps -->
    <section class="apps" id="apps">
      <p class="section-label">{copy.home.sectionLabel}</p>
      <h2 class="section-title">{copy.home.sectionTitle}</h2>
      <div class="apps-grid">
        {apps.map((app) => <AppCard app={app} locale={locale} />)}
      </div>
      <p class="more-note">{copy.home.moreNote}</p>
    </section>
  </main>

  <!-- Footer -->
  <SiteFooter locale={locale} copyright={copy.home.copyright} />
</body>
</html>
