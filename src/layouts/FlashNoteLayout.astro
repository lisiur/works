---
/**
 * FlashNote 内容页骨架：在共享 AppLayout 之上固定本应用的导航项、页脚项、favicon 与版权行。
 * 导航 / 页脚文案取自应用文案数据（src/i18n/messages/apps/flashnote.ts）。
 * 6 个内容页只写自己的 head 元信息与正文区（<slot />），站点层元素一律来自布局。
 */
import AppLayout from './AppLayout.astro';
import { appCopyOf, getApp } from '../i18n';
import '../styles/flashnote.css';

interface Props {
  locale: string;
  /** 'index' | 'privacy' | 'support'：决定语言互切目标形态 */
  page: string;
  title: string;
  description?: string;
  canonical?: string;
  alternates?: import('../i18n').AlternateLink[];
  bodyClass?: string;
}
const { locale, page, title, description, canonical, alternates, bodyClass } = Astro.props;
const app = getApp('flashnote');
if (!app) throw new Error('FlashNote 未在应用清单中登记');
const copy = appCopyOf('flashnote')[locale] as import('../i18n').FlashNoteCopy;
const navLinks = [
  { href: `/${locale}/flashnote/#features`, label: copy.nav.features },
  { href: `/${locale}/flashnote/privacy.html`, label: copy.nav.privacy },
  { href: `/${locale}/flashnote/support.html`, label: copy.nav.support },
];
const footerLinks = [
  { href: `/${locale}/flashnote/support.html`, label: copy.footer.support },
  { href: `/${locale}/flashnote/privacy.html`, label: copy.footer.privacy },
];
---

<AppLayout
  app={app}
  locale={locale}
  page={page}
  title={title}
  description={description}
  canonical={canonical}
  alternates={alternates}
  bodyClass={bodyClass}
  faviconHref="/flashnote/images/favicon.png"
  navLinks={navLinks}
  footerLinks={footerLinks}
  copyright="© 2026 FlashNote. All rights reserved."
>
  <slot />
</AppLayout>
