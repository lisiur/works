---
/**
 * 应用内容页共享骨架（AC3/AC5/AC12）：
 * 语言探测只发生在应用跳转页，内容页不含任何 <script>；
 * nav-links 与 footer-links 第一项由 AppLayout 统一置入「返回主站入口」（ISSUE-122 强制条款由布局保证）；
 * 语言互切写 hapaul-lang，index 页落目录形态、其余页落 <page>.html。
 * 语言胶囊按登记生成：其余每种语言一颗（D3），标签为目标语言自称。
 * 内容页地址为 locale 前置全局路径：/<语言>/<app>/…；
 * 应用自有静态资源仍在 /<app>/images|screenshots/** 不动。
 */
import HeadMeta from '../components/HeadMeta.astro';
import LangPill from '../components/LangPill.astro';
import AllAppsLink from '../components/AllAppsLink.astro';
import { appCopyOf, localeEntryOf, otherLocales, type AppEntry, type AlternateLink } from '../i18n';

export interface NavLink {
  href: string;
  label: string;
}

interface Props {
  app: AppEntry;
  locale: string;
  /** 'index' → 语言互切用目录形态；其余为 <page>.html（与基线解析结果一致） */
  page: string;
  title: string;
  description?: string;
  canonical?: string;
  alternates?: AlternateLink[];
  /** 如 'light-bg'（隐私 / 支持页），与基线一致 */
  bodyClass?: string;
  /** favicon 根绝对路径；不传则不输出（有则保留、无则不新增） */
  faviconHref?: string;
  /** 「返回主站入口」之后的 nav-links / footer-links */
  navLinks?: NavLink[];
  footerLinks?: NavLink[];
  copyright: string;
}
const { app, locale, page, title, description, canonical, alternates, bodyClass, faviconHref, navLinks = [], footerLinks = [], copyright } = Astro.props;
const entry = localeEntryOf(locale);
const info = appCopyOf(app.id)[locale] as { shortName: string };
const others = otherLocales(locale);
const appIndexHref = `/${locale}/${app.id}/`;
/** 目标语言互切地址：index 页目录形态、其余页 <page>.html（DM 链接归一规则） */
const langSwitchHref = (target: string) =>
  page === 'index' ? `/${target}/${app.id}/` : `/${target}/${app.id}/${page}.html`;
---

<!DOCTYPE html>
<html lang={entry.htmlLang}>
<head>
  <HeadMeta title={title} description={description} canonical={canonical} alternates={alternates} />
  {faviconHref && <link rel="icon" type="image/png" href={faviconHref}>}
</head>
<body class={bodyClass}>

  <!-- Navigation -->
  <header class="site-nav">
    <a class="nav-logo" href={appIndexHref}>
      <div class="nav-logo-icon">
        <img src={`/${app.id}/images/icon.png`} alt={app.jumpTitle} class="logo-nav-logo-icon" style="width:28px;height:28px;border-radius:inherit">
      </div>
      <span>{info.shortName}</span>
    </a>
    <div class="nav-right">
      <nav class="nav-links">
        <AllAppsLink locale={locale} />
        {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
      {others.map((target) => <LangPill href={langSwitchHref(target.code)} locale={target.code} label={target.nativeLabel} />)}
    </div>
  </header>

  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-logo">
      <div class="footer-logo-icon">
        <img src={`/${app.id}/images/icon.png`} alt={app.jumpTitle} class="logo-footer-logo-icon" style="width:24px;height:24px;border-radius:inherit">
      </div>
      <span>{info.shortName}</span>
    </div>
    <div class="footer-links">
      <AllAppsLink locale={locale} />
      {footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
    <p>{copyright}</p>
  </footer>

</body>
</html>
