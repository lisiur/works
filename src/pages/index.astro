---
import LangJumpLayout from '../layouts/LangJumpLayout.astro';
import { abs, localeEntries } from '../i18n';
---

<LangJumpLayout
  title="Hapaul Apps"
  description="Hapaul Apps — Lisiur Day 打造的原创应用 · Original apps by Lisiur Day."
  alternates={[
    ...localeEntries.map((entry) => ({ hreflang: entry.hreflang, href: abs(`/${entry.code}/`) })),
    { hreflang: 'x-default', href: abs('/') },
  ]}
/>
