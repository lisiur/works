---
import FlashNoteLayout from '../../../layouts/FlashNoteLayout.astro';
import { abs } from '../../../lib/i18n';
---

<FlashNoteLayout
  locale="zh-CN"
  page="index"
  title="闪记 FlashNote — 捕捉每一个灵感"
  canonical={abs('/zh-CN/flashnote/')}
  alternates={[
    { hreflang: 'zh-Hans', href: abs('/zh-CN/flashnote/') },
    { hreflang: 'en-US', href: abs('/en-US/flashnote/') },
  ]}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-icon">
      <img src="/flashnote/images/icon.png" alt="FlashNote" class="logo-hero-icon" style="width:96px;height:96px;border-radius:inherit">
    </div>
    <h1>闪记</h1>
    <p class="tagline">捕捉每一个灵感</p>
    <div class="hero-badges">
      <a class="badge" href="https://apps.apple.com/cn/app/flashnote/id6824461040?platform=mac" target="_blank" rel="noopener">
        <img src="/flashnote/images/badges/mac-app-store-cnsc.svg" alt="从 Mac App Store 下载" width="140" height="40">
      </a>
      <a class="badge" href="https://apps.apple.com/cn/app/flashnote/id6824461040" target="_blank" rel="noopener">
        <img src="/flashnote/images/badges/app-store-cnsc.svg" alt="从 App Store 下载" width="109" height="40">
      </a>
    </div>
  </section>

  <!-- Features -->
  <section class="features" id="features">
    <p class="section-label">功能特点</p>
    <h2 class="section-title">为你打造的笔记体验</h2>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"/></svg>
        </div>
        <h3>iCloud 实时同步</h3>
        <p>iCloud 自动同步所有设备，随时随地访问，修改即保存。</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
        </div>
        <h3>Markdown 支持</h3>
        <p>实时渲染，写作流畅，让你的文字排版得心应手。</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
        </div>
        <h3>隐私优先</h3>
        <p>数据仅存于你的 iCloud，我们无法访问任何笔记内容。</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
        </div>
        <h3>双平台支持</h3>
        <p>macOS 和 iOS 体验一致，随时切换设备继续写作。</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM7 10h2v7H7zm4-3h2v10h-2zm4 6h2v4h-2z"/></svg>
        </div>
        <h3>简约界面</h3>
        <p>专注内容，无干扰，让写作成为一种享受。</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24"><path d="M22 18V3H2v15H0v2h24v-2h-2zm-8 0h-4v-1h4v1zm6-3H4V5h16v10z"/></svg>
        </div>
        <h3>离线可用</h3>
        <p>无网也能写作，随时同步，不受网络限制。</p>
      </div>
    </div>
  </section>

  <!-- Highlight -->
  <section class="highlight">
    <div class="highlight-inner">
      <h2>简约，却不简单</h2>
      <p>闪记专注于让你专注于内容本身。没有复杂的设置，没有账户注册——只需登录你的 Apple ID，笔记即刻在所有设备间同步。</p>
      <div class="highlight-visual"><img src="/flashnote/screenshots/mac/01-panel-dark.jpg" alt="FlashNote"></div>
    </div>
  </section>

  <!-- Privacy note -->
  <section class="privacy-note">
    <div class="privacy-note-inner">
      <h2>你的隐私，我们守护</h2>
      <p>笔记数据仅存储在你的 iCloud 私有数据库中，端到端加密，我们无法访问任何内容。</p>
      <a href="/zh-CN/flashnote/privacy.html">查看隐私政策 →</a>
    </div>
  </section>
</FlashNoteLayout>
