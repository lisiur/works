---
/**
 * FlashNote 隐私政策模板（页面单份化，ISSUE-129 T5）：按语言登记生成全部语言，
 * 正文取自 src/i18n/copy/apps/flashnote.ts 的 privacy 文案；联系区（SVG + 邮箱）语言中性留模板。
 */
import FlashNoteLayout from '../../../layouts/FlashNoteLayout.astro';
import { appCopyOf, esc, localeEntries } from '../../../i18n';
import type { FlashNoteCopy } from '../../../i18n';

export function getStaticPaths() {
  return localeEntries.map((entry) => ({ params: { locale: entry.code }, props: { locale: entry.code } }));
}

const { locale } = Astro.props;
const copy = appCopyOf('flashnote')[locale] as FlashNoteCopy;
---

<FlashNoteLayout locale={locale} page="privacy" title={copy.privacy.title} bodyClass="light-bg">
  <section class="privacy-page">
    <div class="privacy-content">

      <h1>{copy.privacy.h1}</h1>
      <p class="date">{copy.privacy.date}</p>

      <div class="privacy-card">
        {copy.privacy.sections.map((section) => (
          <>
            <h2>{section.h2}</h2>
            {section.blocks.map((block) => block.type === 'p'
              ? <p set:html={esc(block.text)} />
              : <ul>{block.items.map((item) => <li><strong set:html={esc(item.strong)}></strong><Fragment set:html={esc(item.text)} /></li>)}</ul>)}
          </>
        ))}
        <div class="contact-row">
          <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          <a href="mailto:lisiurday@gmail.com">lisiurday@gmail.com</a>
        </div>
      </div>
    </div>
  </section>
</FlashNoteLayout>
