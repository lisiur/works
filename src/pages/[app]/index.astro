---
/**
 * 应用跳转页（/<app>/）：由应用清单数据驱动（getStaticPaths），
 * 接入新应用登记一条数据即自动获得，站点层零改动（AC11）。
 */
import LangJumpLayout from '../../layouts/LangJumpLayout.astro';
import { apps } from '../../data/apps';
import { abs } from '../../lib/i18n';

export function getStaticPaths() {
  return apps.map((app) => ({ params: { app: app.id }, props: { app } }));
}

const { app } = Astro.props;
---

<LangJumpLayout
  title={app.jumpTitle}
  description={app.jumpDescription}
  alternates={[
    { hreflang: 'zh-Hans', href: abs(`/${app.id}/zh-CN/`) },
    { hreflang: 'en-US', href: abs(`/${app.id}/en-US/`) },
    { hreflang: 'x-default', href: abs(`/${app.id}/`) },
  ]}
  basePath={`/${app.id}`}
/>
